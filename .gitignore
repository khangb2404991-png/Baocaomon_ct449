# ==========================================
# BOOK LENDING SYSTEM - GITIGNORE CONFIGURATION
# ==========================================

# 1. Environment variables & Secrets (Tuyệt đối không push file cấu hình nhạy cảm)
.env
.env.*
backend/.env
frontend/.env
*.env
*.env.*

# Giữ lại file mẫu để hướng dẫn cấu hình môi trường
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies & Libraries (Thư mục gói thư viện)
node_modules/
backend/node_modules/
frontend/node_modules/

# 3. Production Build Outputs & Bundler Cache
dist/
dist-ssr/
frontend/dist/
.vite/
frontend/.vite/
.cache/

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
